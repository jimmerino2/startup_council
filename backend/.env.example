# OpenRouter
OPENROUTER_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Persona model overrides (OpenRouter free-tier model slugs, ":free" suffix).
# Verify current free availability at https://openrouter.ai/models?max_price=0
# before relying on these defaults — free slugs rotate over time, and OpenRouter
# 404s with a "use this slug instead" hint when one is retired; when that happens,
# just update the relevant var below (no code change needed).
# Refreshed 2026-09-23 against the live OpenRouter /models endpoint.
OPENROUTER_MODEL_JUDGE=nex-agi/nex-n2.5-pro:free
OPENROUTER_MODEL_SKEPTIC=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_OPTIMIST=dots-studio/dots-3-note-preview:free
OPENROUTER_MODEL_MARKET_ANALYST=nex-agi/nex-n2.5-mini:free
OPENROUTER_MODEL_TECH_LEAD=cohere/north-mini-code:free
OPENROUTER_MODEL_VC_INVESTOR=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_MODEL_CHAIRMAN=nvidia/nemotron-3-ultra-550b-a55b:free
# If the chairman model fails after retries, these are tried in order as a fallback
# (no env override needed for these — see CHAIRMAN_FALLBACK_MODELS in personas.ts).

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Secret used to encrypt user-saved OpenRouter/Gemini API keys at rest (AES-256-GCM,
# see backend/src/services/crypto.ts). Any long random string; generate with
# `openssl rand -base64 32`. Changing this makes previously-saved keys undecryptable.
API_KEY_ENCRYPTION_SECRET=

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite) - only VITE_-prefixed vars reach the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:3001
